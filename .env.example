# Supabase > botão "Connect" > aba "ORMs" > Prisma
# Conexão com pool (Transaction pooler, porta 6543) — usada pelo app
DATABASE_URL="postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Conexão direta (Session pooler, porta 5432) — usada pelo prisma db push
DIRECT_URL="postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="troque-por-um-segredo-aleatorio"

# Recuperação de senha por e-mail. Opção 1 (preferida): Gmail com "senha de app"
# (myaccount.google.com/apppasswords; exige verificação em 2 etapas).
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# Opção 2: Resend (resend.com > API Keys). Usado só se o Gmail não estiver configurado.
# Sem nenhuma das duas em desenvolvimento, o e-mail é mostrado no terminal.
RESEND_API_KEY=""
# Sem domínio verificado no Resend, deixe o padrão (só entrega para o e-mail da conta Resend)
EMAIL_FROM="Finanças <onboarding@resend.dev>"
# Endereço público do app, usado no link do e-mail (na Vercel, o domínio de produção é usado se vazio)
APP_URL=""

# E-mail de contato exibido na Política de privacidade e na página "Como excluir sua conta"
CONTACT_EMAIL=""
# Play Store (app Android via TWA): preencher só na hora de publicar
ANDROID_PACKAGE=""
ANDROID_SHA256=""
